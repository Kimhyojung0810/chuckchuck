# [이 파일] 로컬 실행에 필요한 환경변수 예시입니다. 복사해서 .env 로 쓰고 키만 채우세요. (.env 는 깃에 올리지 않음)
# 척척발표 로컬 환경변수 예시
# cp .env.example .env  후 값을 채운다. .env 는 커밋하지 말 것.

# true 면 외부 API 대신 fixtures / mock provider 사용
MOCK_EXTERNAL_APIS=true

# ----- Upstage Document Parse (F-01) + Solar (F-06 기본) -----
# 키 발급: https://console.upstage.ai → API Keys → Create New Key
# (활용법 PDF에는 키 없음. AI Initiative면 Solar+DP 무료 ~2026-03-31)
UPSTAGE_API_KEY=
UPSTAGE_DOCPARSE_URL=https://api.upstage.ai/v1/document-digitization
UPSTAGE_DOCPARSE_ASYNC_URL=https://api.upstage.ai/v1/document-digitization/async
UPSTAGE_DOCPARSE_MODEL=document-parse
UPSTAGE_DOCPARSE_MODE=auto
UPSTAGE_DOCPARSE_OCR=auto
UPSTAGE_DOCPARSE_OUTPUT_FORMATS=["html", "markdown", "text"]
UPSTAGE_DOCPARSE_USE_ASYNC_THRESHOLD_PAGES=10
# F-01 장수 한도 (기본 100, Upstage sync 한도와 맞춤. 예전 제품 권장은 30)
CHUCKCHUCK_MAX_SLIDES=100
# raw 스키마 실측 시 true (평소 false). dump_parse_raw.py 는 코드에서 true 강제
UPSTAGE_DOCPARSE_COORDINATES=false
# true 면 parse_document 호출마다 fixtures/raw/ 에 raw+keys 저장
SAVE_PARSE_RAW=false
# UPSTAGE_PARSE_RAW_DIR=fixtures/raw
UPSTAGE_SOLAR_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_SOLAR_MODEL=solar-pro3

# ----- SKT A.X STT (F-05) -----
# 문서: https://portal.adot.ai/docs/stt-api-guide
# 인증: LLM 은 Authorization Bearer, STT 는 X-API-Key (같은 awf_ 키)
AX_STT_API_KEY=
AX_STT_BASE_URL=https://awf-gw.adot.ai
AX_STT_BATCH_MODEL=A.X_STT_note_batch
AX_STT_STREAMING_MODEL=A.X_STT_note_streaming
STT_PROVIDER=skt-ax

# ----- LLM (F-06) -----
# solar | ax | midm | exaone | mock
REASONING_BACKEND=solar
# 주 백엔드가 연결·상태 오류나 빈 응답을 내면 한 번 넘길 예비. 비우면 예비 없음. 답한 쪽이 결과의 model 에 남는다.
REASONING_FALLBACK=ax

AX_API_KEY=
AX_BASE_URL=https://awf-gw.adot.ai/v1
AX_MODEL=A.X-K1

# ----- KT 믿:음 (공식 API, 2026-09-22 갱신) -----
# 호출 주소: https://midm.kt.com/v1/chat/completions  (코드가 MIDM_BASE_URL + /chat/completions 로 조립)
# 헤더: Authorization: Bearer <API_KEY> / Content-Type: application/json; charset=UTF-8
# 모델 ID: midm-pro-fp8-kaic  (MIDM_ENDPOINT_ID 가 요청의 model 필드로 들어간다)
# 키: 팀별로 전달받은 KT 믿:음 API Key
# (예전 Friendli dedicated 엔드포인트는 2026-08-11 종료됨. 로컬 서빙이 필요하면
#   MIDM_BASE_URL=http://127.0.0.1:8010/v1 / MIDM_ENDPOINT_ID=midm / MIDM_API_KEY=local)
MIDM_API_KEY=
MIDM_BASE_URL=https://midm.kt.com/v1
MIDM_ENDPOINT_ID=midm-pro-fp8-kaic

EXAONE_API_KEY=
EXAONE_BASE_URL=https://api.friendli.ai/dedicated/v1
EXAONE_ENDPOINT_ID=


# ----- F-18 음성 습관 (LoRA 태거) -----
# lora (기본) | heuristic
# callers: f18_habits / demo/run_bridge_midm.sh / .env
# 주의: LoRA 는 torch+GPU 필요. 기본 python bridge 는 heuristic 로 떨어짐.
# 실사용: ./demo/run_bridge_midm.sh
# user: "LoRA 같이 돌아가는걸 봐야하는데..."
HABIT_PROVIDER=lora
CHUCKCHUCK_LORA_PATH=/path/to/lora/adapter
# LoRA가 담당할 태그. 기본 REP만 (FIL은 heuristic 보강)
CHUCKCHUCK_LORA_KINDS=REP

# ----- 질문 코칭 (F-08·F-09) 근거 예산 -----
# 개념 하나에 붙일 근거 장 수. F-07 이 12장을 붙여도 본문이 그 개념을 말하는 장만 남는다.
# CHUCKCHUCK_QA_ANCHOR_SLIDES=3
# 질문 생성·판정 프롬프트에 실을 자료 본문 글자 수 (정제 후). 0 이면 끈다.
# CHUCKCHUCK_QA_SLIDE_BODY_MAX=1200
# CHUCKCHUCK_JUDGE_SLIDE_BODY_MAX=1200
# 측정: python examples/qa_eval.py --tag <이름>  → exports/qa_eval/ 에 전후 비교표

# ----- F-24 문헌 (교수가 읽고 온 논문 · 자유 논문 검색) -----
# 통로: openalex | semanticscholar | arxiv | crossref | europepmc | all | none. 쉼표로 여러 개 (동시에 부르고 합친다).
#   all  = openalex,arxiv,europepmc (+semanticscholar 는 S2_API_KEY 가 있을 때 — 키 없이는 3번째 요청부터 429)
#   none = 자료가 인용한 참고문헌(deck)만 쓰고 외부 검색은 안 한다.
# 켜면 질문 생성 때 상위 개념 5개 × 2편 + 자료 인용 되찾기(최대 5)를 가져온다 (전부 키 없음·무료). 세션에 한 번, 캐시.
# 한 통로가 죽어도 나머지로 간다. 실측(09-23): openalex 1~2초 · arxiv 0.3초 · europepmc 2~10초 · crossref 는 초록이 없어 되찾기용.
SCHOLAR_PROVIDER=all
# polite pool — 넣으면 OpenAlex·Crossref 가 더 빠르고 넉넉하게 받아 준다 (팀 메일). OPENALEX_MAILTO 도 같은 뜻.
# SCHOLAR_MAILTO=
# Semantic Scholar 키 (선택, 무료 신청) — 있으면 all 에 semanticscholar 가 끼고 한도가 오른다
# S2_API_KEY=
# 검색 요청 시간 초과(초). 넘기면 자료 인용만으로 질문을 만든다.
# SCHOLAR_TIMEOUT_SEC=8
# 자료 인용을 검색으로 되찾아 DOI·초록을 채울 최대 개수
# CHUCKCHUCK_PAPER_RESOLVE_MAX=5

# ----- demo bridge -----
DEMO_HOST=127.0.0.1
DEMO_PORT=8787
# 업로드·파싱본·받아쓰기·분석 산출물이 남는 자리 (기본 var/data — git 이 무시한다).
# 세션마다 var/data/sessions/YYYY/MM/DD/<타임스탬프>_<난수>/ 로 남아 ls 만으로 시간순이다.
# DEMO_DATA_DIR=/var/lib/chuckchuck
# 동의 없는 세션의 파싱본·받아쓰기 캐시 수명(시간) / 동의한 세션의 보관 기간(일, About 화면의 약속)
# DEMO_CACHE_TTL_HOURS=24
# DEMO_RETENTION_DAYS=365
# F-06·F-07 내용 해시 캐시 수명(시간)
# DEMO_STAGE_CACHE_TTL_HOURS=72
# 저장된 세션 **목록**(/api/v1/cached-takes, #/replay). 개발자 화면이라 기본 닫힘 —
# 열면 주소를 아는 누구나 남의 발표 기록을 본다. 로컬에서 반복 테스트할 때만 1.
# DEMO_DEV_ROUTES=0
# 과금 경로의 사람당 분당 상한 (0 이면 끔)
# DEMO_RATE_LIMIT_PER_MIN=30
# LoRA 포함: DEMO_PORT=8799 ./demo/run_bridge_midm.sh
