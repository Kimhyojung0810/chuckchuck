# [이 파일] 로컬 실행에 필요한 환경변수 예시입니다. 복사해서 .env 로 쓰고 키만 채우세요. (.env 는 깃에 올리지 않음)
# 척척발표 로컬 환경변수 예시
# cp .env.example .env  후 값을 채운다. .env 는 커밋하지 말 것.

# true 면 외부 API 대신 fixtures / mock provider 사용
MOCK_EXTERNAL_APIS=true

# ----- Upstage Document Parse (F-01) + Solar (F-06 기본) -----
# 키 발급: https://console.upstage.ai → API Keys → Create New Key
# (활용법 PDF에는 키 없음. AI Initiative면 Solar+DP 무료 ~2026-03-31)
UPSTAGE_API_KEY=
UPSTAGE_DOCPARSE_URL=https://api.upstage.ai/v1/document-digitization
UPSTAGE_DOCPARSE_ASYNC_URL=https://api.upstage.ai/v1/document-digitization/async
UPSTAGE_DOCPARSE_MODEL=document-parse
UPSTAGE_DOCPARSE_MODE=auto
UPSTAGE_DOCPARSE_OCR=auto
UPSTAGE_DOCPARSE_OUTPUT_FORMATS=["html", "markdown", "text"]
UPSTAGE_DOCPARSE_USE_ASYNC_THRESHOLD_PAGES=10
# F-01 장수 한도 (기본 100, Upstage sync 한도와 맞춤. 예전 제품 권장은 30)
CHUCKCHUCK_MAX_SLIDES=100
# raw 스키마 실측 시 true (평소 false). dump_parse_raw.py 는 코드에서 true 강제
UPSTAGE_DOCPARSE_COORDINATES=false
# true 면 parse_document 호출마다 fixtures/raw/ 에 raw+keys 저장
SAVE_PARSE_RAW=false
# UPSTAGE_PARSE_RAW_DIR=fixtures/raw
UPSTAGE_SOLAR_BASE_URL=https://api.upstage.ai/v1
UPSTAGE_SOLAR_MODEL=solar-pro3

# ----- SKT A.X STT (F-05) -----
# 문서: https://portal.adot.ai/docs/stt-api-guide
# 인증: LLM 은 Authorization Bearer, STT 는 X-API-Key (같은 awf_ 키)
AX_STT_API_KEY=
AX_STT_BASE_URL=https://awf-gw.adot.ai
AX_STT_BATCH_MODEL=A.X_STT_note_batch
AX_STT_STREAMING_MODEL=A.X_STT_note_streaming
STT_PROVIDER=skt-ax

# ----- LLM (F-06) -----
# solar | ax | midm | exaone | mock
REASONING_BACKEND=solar

AX_API_KEY=
AX_BASE_URL=https://awf-gw.adot.ai/v1
AX_MODEL=A.X-K1

# ----- KT 믿음 -----
# 2026-08-11: Friendli dedicated 엔드포인트가 종료(HTTP 410 TERMINATED)됐다.
# 재시작은 friendli.ai 대시보드 로그인이 필요하다.
# 로컬 서빙으로 대체할 수 있다 (가중치 22GB 로컬 보유, 새 의존성 없음):
#   CUDA_VISIBLE_DEVICES=1 python /home/ubuntu/workspace/20_AIHub_data/src/serve_midm.py --port 8010
# 그 뒤 아래 세 줄을 쓰면 코드 수정 없이 붙는다:
#   MIDM_BASE_URL=http://127.0.0.1:8010/v1
#   MIDM_ENDPOINT_ID=midm
#   MIDM_API_KEY=local
MIDM_API_KEY=
MIDM_BASE_URL=https://api.friendli.ai/dedicated/v1
MIDM_ENDPOINT_ID=

EXAONE_API_KEY=
EXAONE_BASE_URL=https://api.friendli.ai/dedicated/v1
EXAONE_ENDPOINT_ID=


# ----- F-18 음성 습관 (LoRA 태거) -----
# lora (기본) | heuristic
# callers: f18_habits / demo/run_bridge_midm.sh / .env
# 주의: LoRA 는 torch+GPU 필요. 기본 python bridge 는 heuristic 로 떨어짐.
# 실사용: ./demo/run_bridge_midm.sh
# user: "LoRA 같이 돌아가는걸 봐야하는데..."
HABIT_PROVIDER=lora
CHUCKCHUCK_LORA_PATH=/path/to/lora/adapter
# LoRA가 담당할 태그. 기본 REP만 (FIL은 heuristic 보강)
CHUCKCHUCK_LORA_KINDS=REP

# ----- demo bridge -----
DEMO_HOST=127.0.0.1
DEMO_PORT=8787
# LoRA 포함: DEMO_PORT=8799 ./demo/run_bridge_midm.sh
