{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chuckchuck/booth-mobile/tour.schema.json",
  "title": "척척발표 모바일 체험 투어 녹화 데이터 (v1)",
  "description": "#/tour/* 가 읽는 한 벌의 녹화 체험. 파일은 demo/YEHS_demo/data/tour/<id>.json. 투어는 이 파일만 읽고 API 를 부르지 않는다. 문서: docs/booth-mobile/tour-schema.md. 이 파일이 단일 원본이다 — 모양을 바꾸려면 여기부터 고치고 tests/test_booth_mobile_contract.py 를 돌린다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "id", "source", "deck", "present", "analysis", "qa", "report"],
  "properties": {
    "schema": { "const": "chuckchuck.tour" },
    "version": { "const": 1, "description": "모양이 깨지는 변경이면 2 로 올리고 프론트가 모르는 버전은 「체험을 불러오지 못했어요」 로 처리한다." },
    "id": { "type": "string", "pattern": "^_?[a-z0-9][a-z0-9-]{0,39}$", "description": "파일 이름(확장자 뺀 것)과 같다." },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "recorded_at", "note"],
      "properties": {
        "kind": { "enum": ["example", "recorded"], "description": "example=형식 설명용 예시(화면에 「예시」 표시), recorded=실제 리허설을 녹화한 응답." },
        "recorded_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "note": { "type": "string", "maxLength": 200, "description": "어디서 어떻게 만들었는지(사람용). 화면에 안 나온다." }
      }
    },
    "deck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "cover", "slides"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "assets/deck-slides/<id>/ 폴더 이름." },
        "title": { "type": "string", "minLength": 1, "maxLength": 40 },
        "subtitle": { "type": ["string", "null"], "maxLength": 40 },
        "cover": { "$ref": "#/$defs/assetPath" },
        "slides": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["no", "image", "title"],
            "properties": {
              "no": { "$ref": "#/$defs/slideNo" },
              "image": { "$ref": "#/$defs/assetPath" },
              "title": { "type": "string", "minLength": 1, "maxLength": 40 }
            }
          }
        }
      }
    },
    "present": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_sec", "slides", "transcript", "coaching_chips"],
      "properties": {
        "duration_sec": { "type": "number", "minimum": 1, "maximum": 900 },
        "slides": {
          "type": "array", "minItems": 1,
          "description": "장별 넘김 시각. 장 번호 순서, 구간이 겹치지 않는다.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slide_no", "start_sec", "end_sec"],
            "properties": {
              "slide_no": { "$ref": "#/$defs/slideNo" },
              "start_sec": { "type": "number", "minimum": 0 },
              "end_sec": { "type": "number", "minimum": 0 }
            }
          }
        },
        "transcript": {
          "type": "array", "minItems": 1,
          "description": "발화 전사 조각. 재생 시각에 맞춰 자막처럼 흘린다.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slide_no", "start_sec", "end_sec", "text"],
            "properties": {
              "slide_no": { "$ref": "#/$defs/slideNo" },
              "start_sec": { "type": "number", "minimum": 0 },
              "end_sec": { "type": "number", "minimum": 0 },
              "text": { "type": "string", "minLength": 1, "maxLength": 80 }
            }
          }
        },
        "coaching_chips": {
          "type": "array",
          "description": "실시간 코칭 칩. kind 는 비전 리허설 삐약이 반응(js/vision_cue.js REACTS)에 군더더기·시간을 더한 것.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at_sec", "slide_no", "kind", "text"],
            "properties": {
              "at_sec": { "type": "number", "minimum": 0 },
              "slide_no": { "$ref": "#/$defs/slideNo" },
              "kind": { "enum": ["listen", "fast", "slow", "quiet", "loud", "filler", "time"] },
              "text": { "type": "string", "minLength": 1, "maxLength": 16 }
            }
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "level", "slide_times", "pace", "fillers", "claim_graph"],
      "properties": {
        "summary": { "type": "string", "minLength": 1, "maxLength": 90 },
        "level": { "$ref": "#/$defs/level" },
        "slide_times": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slide_no", "sec", "level"],
            "properties": {
              "slide_no": { "$ref": "#/$defs/slideNo" },
              "sec": { "type": "number", "minimum": 0 },
              "level": { "$ref": "#/$defs/level" },
              "note": { "type": ["string", "null"], "maxLength": 40 }
            }
          }
        },
        "pace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpm", "level", "note"],
          "properties": {
            "cpm": { "type": "number", "minimum": 0, "maximum": 1000, "description": "말 속도, 자/분. 권장 300~350 (js/vision_cue.js)." },
            "level": { "$ref": "#/$defs/level" },
            "note": { "type": "string", "maxLength": 40 }
          }
        },
        "fillers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "per_min", "top", "level"],
          "properties": {
            "count": { "type": "integer", "minimum": 0 },
            "per_min": { "type": "number", "minimum": 0 },
            "top": {
              "type": "array", "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["word", "count"],
                "properties": {
                  "word": { "type": "string", "minLength": 1, "maxLength": 8 },
                  "count": { "type": "integer", "minimum": 1 }
                }
              }
            },
            "level": { "$ref": "#/$defs/level" }
          }
        },
        "claim_graph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "root", "nodes", "edges"],
          "description": "핵심 주장 그래프 요약. 루트=주장 문장(개념 그래프 1-1). status 는 정합 판정 enum(chuckchuck/contracts.py ALIGN_VERDICTS) 그대로 — 판정 색 5종과 짝이라 새 값을 만들지 않는다.",
          "properties": {
            "summary": { "type": "string", "maxLength": 90 },
            "root": { "type": "string", "description": "nodes[].id 중 하나." },
            "nodes": {
              "type": "array", "minItems": 1, "maxItems": 12,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "label", "kind", "status", "slide_no"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
                  "label": { "type": "string", "minLength": 1, "maxLength": 30 },
                  "kind": { "enum": ["claim", "reason", "evidence", "concept"] },
                  "status": { "enum": ["aligned", "justified_skip", "missing", "contradiction"] },
                  "slide_no": { "type": ["integer", "null"], "minimum": 1 }
                }
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to"],
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asker", "questions"],
      "properties": {
        "asker": { "type": "string", "maxLength": 12, "description": "질문하는 역할 이름표(교수님·심사위원 …)." },
        "questions": {
          "type": "array", "minItems": 1, "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "slide_no", "question", "answers"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
              "slide_no": { "$ref": "#/$defs/slideNo" },
              "question": { "type": "string", "minLength": 1, "maxLength": 120 },
              "answers": {
                "type": "object",
                "additionalProperties": false,
                "required": ["good", "rough"],
                "description": "good=「잘 답한 답」, rough=「엉성한 답」. 방문객이 둘 중 하나를 눌러 판정을 비교한다.",
                "properties": {
                  "good": { "$ref": "#/$defs/answer" },
                  "rough": { "$ref": "#/$defs/answer" }
                }
              }
            }
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "items", "next_steps"],
      "properties": {
        "headline": { "type": "string", "minLength": 1, "maxLength": 40 },
        "items": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "level", "note"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 14 },
              "level": { "$ref": "#/$defs/level" },
              "note": { "type": "string", "maxLength": 60 }
            }
          }
        },
        "next_steps": {
          "type": "array", "minItems": 1, "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "slide_no"],
            "properties": {
              "text": { "type": "string", "minLength": 1, "maxLength": 60 },
              "slide_no": { "type": ["integer", "null"], "minimum": 1 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "slideNo": { "type": "integer", "minimum": 1, "maximum": 20 },
    "assetPath": {
      "type": "string",
      "pattern": "^assets/(deck-covers/[A-Za-z0-9_.-]+|deck-slides/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)\\.webp$",
      "description": "index.html 기준 상대 경로, ?v= 없이. 공개 허용 목록(demo/static_assets.py _PUBLIC_PATH) 안이어야 한다."
    },
    "level": {
      "enum": ["good", "fair", "practice"],
      "description": "3단계 말 평가. 화면 글자는 good=「좋아요」 · fair=「보통」 · practice=「더 연습」 로 고정. 숫자를 화면에 바로 내지 않는다."
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "verdict", "level", "feedback", "grounds"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "verdict": { "enum": ["good", "partial", "wrong", "unknown"], "description": "F-09 판정 enum(chuckchuck/f09_judge.py) 그대로." },
        "level": { "$ref": "#/$defs/level" },
        "feedback": { "type": "string", "minLength": 1, "maxLength": 90 },
        "grounds": {
          "type": "array", "maxItems": 3,
          "description": "판정 근거 줄. 서버 grounds(chuckchuck/_judge_grounds.py JudgeGround)와 같은 이름 — 녹화 응답을 그대로 옮겨 담을 수 있게.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slide_no", "ref", "quote", "role", "note"],
            "properties": {
              "slide_no": { "$ref": "#/$defs/slideNo" },
              "ref": { "type": "string", "pattern": "^S\\d+-\\d+$", "description": "장-줄 번호 (S4-2 = 4장 둘째 줄)." },
              "quote": { "type": "string", "minLength": 1, "maxLength": 80, "description": "자료 줄 그대로." },
              "role": { "enum": ["covered", "missing", "conflict"], "description": "짚은 것 · 빠진 것 · 다시 볼 곳 (js/qa_live.js LIVE_GROUND_ROLE)." },
              "note": { "type": "string", "maxLength": 60, "description": "왜 이 줄이 근거인지." }
            }
          }
        }
      }
    }
  }
}
