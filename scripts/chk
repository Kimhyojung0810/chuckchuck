#!/usr/bin/env python3
# 이 파일: 저장소 개발 도구 `chk` 의 진입점. 실제 코드는 scripts/chk_lib/ 에 있다.
#
#   scripts/chk gate            커밋 전 문지기 (pytest · node 스모크 · ?v= · 비밀키)
#   scripts/chk bump            바뀐 css/js 의 ?v= 캐시 버전을 올린다
#   scripts/chk doctor          이 머신에서 브리지가 뜰 조건을 점검한다
#   scripts/chk warmup          브리지를 예열하고 provider=lora 인지 확인한다
#   scripts/chk brief           세션 시작 브리핑 (할 일 · 장부 · WORKLOG · git)
#   scripts/chk ledger-chart    장부의 IMPROVED 줄을 이어 결선 그래프(SVG)를 그린다
#   scripts/chk install-hooks   git pre-commit 훅으로 gate 를 건다
#
# 전부 표준 라이브러리만 쓴다. LLM 호출 없음, 과금 없음.
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from chk_lib.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
