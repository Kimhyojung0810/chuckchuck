#!/usr/bin/env bash
# git pre-commit 훅 — `scripts/chk install-hooks` 가 core.hooksPath 를 여기로 돌린다.
# 인덱스에 올라간 것만 검사한다 (pytest · node 스모크 · ?v= · 비밀키). 실패면 커밋이 안 된다.
# 훅이 고장났을 때만 CHK_SKIP_GATE=1 git commit … 으로 건너뛴다.
set -euo pipefail
[[ "${CHK_SKIP_GATE:-0}" == "1" ]] && exit 0
ROOT="$(git rev-parse --show-toplevel)"
exec "$ROOT/scripts/chk" gate --scope staged
