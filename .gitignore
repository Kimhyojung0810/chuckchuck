.venv/
__pycache__/
*.pyc
.env
# .env 를 손으로 백업하면 .env 패턴에 안 걸려서 실키가 그대로 올라간다 (2026-08-14)
.env.bak*
.env.backup*
.env.local
.DS_Store
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
_adot_*
_stt_*
_service_*
_chunk*
_out.txt
_doc.html
main/web/.git/

# logs / local dumps
*.log
etc/fixtures/*.log
# LibreOffice PPTX→PDF 미리보기 캐시 (로컬 생성물)
etc/fixtures/raw/*.preview.pdf
_adot_*/
_stt_*/
_service_*/
_chunk*/
_out.txt
_doc.html

# editor
.idea/
.vscode/
var/
__pycache__/
*.pyc

# Netlify 빌드가 chuckchuck/sdk 에서 복사해 만드는 사본 (netlify.toml 참고)
main/web/sdk/

# 데모 입력 녹음 (11MB). 이력에 들어가면 되돌리기 어렵다 — PDF 만 넣는다
main/decks/*.m4a
main/decks/*.mp3
main/decks/*.wav
main/decks/*.webm

# 화면 확인용 스크린샷 (로컬 산출물)
screenshots/

# 세션 보관소 (업로드 원본·파싱본·받아쓰기·분석 산출물). var/ 전체가 위에서 무시되지만
# 여기가 그 자리라는 것을 적어 둔다 — 실제 발표 자료를 다시는 이력에 넣지 않는다 (2026-09-10)
var/data/

# 예전 자리(etc/fixtures/raw). 브리지는 더 쓰지 않지만 옛 로컬 산출물이 남아 있을 수 있어 한 릴리스 둔다
etc/fixtures/raw/stage_cache/

# 녹음 받아쓰기는 발표자 음성 전문이라 로컬에만 둔다 (2026-08-08 지시).
# 재사용은 etc/fixtures/raw 에 그대로 있으면 되고, 저장소에 올릴 이유는 없다.
etc/fixtures/raw/*.transcript.json

# 벤치마크 결과 원본 — AUTONOMOUS_LOOP §5 "무시됨(로컬)". 장부(docs/*_LEDGER.md)가 커밋되는 기록이다 (2026-09-13)
etc/bench/results/qa_eval/
etc/bench/results/graph_eval/
etc/labs/qa_call/out/
etc/labs/qa_lab/out/
etc/labs/qa_bench/out/

# 덱 폴더(main/decks/<덱>/) — 위 규칙대로 PDF 만 올린다. PPTX·녹음·클로바 전사·대본은 로컬에만 (2026-09-29, main/decks/README.md)
main/decks/**/*.pptx
main/decks/**/*.txt
main/decks/**/*.docx
main/decks/**/*.m4a
main/decks/**/*.mp3
main/decks/**/*.wav
main/decks/**/*.webm
main/decks/**/*.ogg
main/decks/**/*.aac
main/decks/**/*.flac
main/decks/**/*.mp4
etc/labs/test_qa/out/
etc/labs/temp_flow/out/
etc/labs/vision_flow/out/
etc/labs/booth_load/out/
etc/labs/booth_qa/out/
etc/labs/rehearsal_flow/out/
# 투어 녹화 원본 — 덱 본문 · 발표 전사 · 세션 보관소. 공개 파일(data/tour)만 커밋한다 (2026-10-11)
etc/labs/tour_capture/out/
etc/labs/tour_flow/out/
etc/labs/mobile_tour/out/
# 분석 자료 폴더의 전사·파싱본 — 발표자 음성 전문·덱 본문이다. 스크립트로 다시 만든다 (2026-09-29)
tools/bin/
# 덱 폴더의 참고/ (대본 PDF·타임스탬프 사진) — 팀 자료라 로컬에만. 목록은 이 하위 폴더를 안 읽는다 (2026-10-01)
main/decks/**/참고/
etc/labs/intro_flow/out/
# MediaPipe 런타임·모델 (etc/scripts/get_mediapipe.sh 로 받는다, 합 ~29MB) — lab/eval-1008 과 같은 줄
main/web/js/vendor/mediapipe/
etc/labs/booth_scan/out/
etc/labs/intro_metrics/out/

# 가상 발표 스튜디오 React 앱 — 의존성은 npm install 로 (빌드 결과 main/web/js/studio-app.js 만 올린다)
main/web/studio-app/node_modules/

# Apple HIG 원문 · apple.com 캡처 — 저작물이라 공개 저장소에 올리지 않는다(로컬 참고용). 요약은 etc/design-ref/apple/README.md
etc/design-ref/apple/hig/
etc/design-ref/apple/shots/
etc/design-ref/output/apple-kr.png
etc/design-ref/output/apple.com/*.json
