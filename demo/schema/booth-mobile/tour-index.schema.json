{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chuckchuck/booth-mobile/tour-index.schema.json",
  "title": "척척발표 모바일 체험 투어 목록 (v1)",
  "description": "demo/YEHS_demo/data/tour/index.json — 녹화된 투어(data/tour/<id>.json) 목록. #/tour/deck 이 덱 고르기 카드와 기본 덱을 여기서 읽는다(투어 파일을 다 받지 않고). labs/tour_capture/build.py 가 투어 파일과 함께 만든다. 형식 예시(_ 로 시작하는 파일)는 싣지 않는다. 문서: docs/booth-mobile/tour-schema.md §목록.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "default", "tours"],
  "properties": {
    "schema": { "const": "chuckchuck.tour-index" },
    "version": { "const": 1 },
    "default": { "type": ["string", "null"], "description": "처음 보여 줄 투어 id — tours[].id 중 하나. 투어가 없으면 null." },
    "tours": {
      "type": "array", "maxItems": 10,
      "description": "보여 줄 차례. 각 id 에 data/tour/<id>.json 이 있어야 한다.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "title", "subtitle", "cover", "slides", "duration_sec", "questions", "recorded_at"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$", "description": "투어 파일 이름 = 투어 id = deck.id." },
          "label": { "type": "string", "maxLength": 8, "description": "부스 덱 이름표(C-1 · A-1 · B-1). 화면이 작은 알약으로 쓸 수 있다." },
          "title": { "type": "string", "minLength": 1, "maxLength": 40, "description": "투어 파일 deck.title 과 같다." },
          "subtitle": { "type": ["string", "null"], "maxLength": 40 },
          "cover": { "type": "string", "pattern": "^assets/deck-covers/[A-Za-z0-9_.-]+\\.webp$" },
          "slides": { "type": "integer", "minimum": 1, "maximum": 20, "description": "장 수." },
          "duration_sec": { "type": "number", "minimum": 1, "maximum": 900, "description": "발표 재생 길이(초) — 「2분 20초」 처럼 보여 줄 수 있다." },
          "questions": { "type": "integer", "minimum": 1, "maximum": 5, "description": "체험할 질문 수." },
          "recorded_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
