        "slide_no": 2,
        "start_sec": 48.95,
        "end_sec": 53.31,
        "text": "이건 기각됐습니다 두 번째가 핵심인데요."
      },
      {
        "slide_no": 2,
        "start_sec": 53.35,
        "end_sec": 55.24,
        "text": "리뷰 이벤트입니다."
