      },
      {
        "slide_no": 2,
        "start_sec": 12.07,
        "end_sec": 15.84,
        "text": "배달 앱에서 매장 고르실 때 별점 보시잖아요."
      },
      {
        "slide_no": 2,
        "start_sec": 16.22,
